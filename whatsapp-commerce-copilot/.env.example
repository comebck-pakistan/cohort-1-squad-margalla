# ============================================================
# WhatsApp Commerce Copilot — Environment Configuration
# Copy to .env and fill in values.
# ============================================================

# --- Database ---
# For Docker: postgresql+asyncpg://wcc_user:wcc_dev_password@postgres:5432/whatsapp_commerce
# For local dev: sqlite+aiosqlite:///./dev.db
DATABASE_URL=sqlite+aiosqlite:///./dev.db
POSTGRES_PASSWORD=wcc_dev_password

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# --- Internal Service Auth ---
INTERNAL_SERVICE_TOKEN=dev-internal-token

# --- AI Provider ---
# Options: mock, openrouter
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- WhatsApp Gateway (adapter) ---
GATEWAY_PORT=3001
GATEWAY_URL=http://localhost:3001
BACKEND_URL=http://localhost:8000

# --- Evolution API ---
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=http://localhost:3001/webhook/evolution
EVOLUTION_API_VERSION=2.3.7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_DEMO=10/minute
RATE_LIMIT_INTERNAL=100/minute

